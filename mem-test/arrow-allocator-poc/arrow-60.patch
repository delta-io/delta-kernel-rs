+// SPDX-License-Identifier: Apache-2.0
+
+//! Allocator injection for the local Kernel allocation experiment.
+
+use std::alloc::{AllocError, Allocator, Global, Layout};
+use std::fmt;
+use std::panic::RefUnwindSafe;
+use std::ptr::NonNull;
+use std::sync::OnceLock;
+
+type BackingAllocator = dyn Allocator + Send + Sync + RefUnwindSafe;
+
+static DEFAULT_ALLOCATOR: OnceLock<&'static BackingAllocator> = OnceLock::new();
+
+/// Install the allocator used by subsequently created participating Arrow storage.
+/// Existing storage retains the allocator that created it.
+pub fn install_default_allocator(allocator: &'static BackingAllocator) -> Result<(), &'static str> {
+    DEFAULT_ALLOCATOR
+        .set(allocator)
+        .map_err(|_| "Arrow allocator is already installed")
+}
+
+/// A copyable owner reference retained by an allocation until its final release.
+#[derive(Clone, Copy)]
+pub struct SharedAllocator(Option<&'static BackingAllocator>);
+
+impl SharedAllocator {
+    /// The system allocator for storage imported from ordinary Rust vectors.
+    pub const fn global() -> Self {
+        Self(None)
+    }
+
+    /// Whether this allocation can be returned to an ordinary Rust vector.
+    pub fn is_global(self) -> bool {
+        self.0.is_none()
+    }
+
+    fn backing(self) -> &'static BackingAllocator {
+        self.0.unwrap_or(&Global)
+    }
+}
+
+impl Default for SharedAllocator {
+    fn default() -> Self {
+        Self(DEFAULT_ALLOCATOR.get().copied())
+    }
+}
+
+impl fmt::Debug for SharedAllocator {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        f.debug_struct("SharedAllocator")
+            .field("global", &self.is_global())
+            .finish()
+    }
+}
+
+// SAFETY: Each operation uses the same retained allocator and forwards the caller's layouts.
+unsafe impl Allocator for SharedAllocator {
+    fn allocate(&self, layout: Layout) -> Result<NonNull<[u8]>, AllocError> {
+        self.backing().allocate(layout)
+    }
+    fn allocate_zeroed(&self, layout: Layout) -> Result<NonNull<[u8]>, AllocError> {
+        self.backing().allocate_zeroed(layout)
+    }
+    unsafe fn deallocate(&self, ptr: NonNull<u8>, layout: Layout) {
+        unsafe { self.backing().deallocate(ptr, layout) }
+    }
+    unsafe fn grow(
+        &self,
+        ptr: NonNull<u8>,
+        old: Layout,
+        new: Layout,
+    ) -> Result<NonNull<[u8]>, AllocError> {
+        unsafe { self.backing().grow(ptr, old, new) }
+    }
+    unsafe fn grow_zeroed(
+        &self,
+        ptr: NonNull<u8>,
+        old: Layout,
+        new: Layout,
+    ) -> Result<NonNull<[u8]>, AllocError> {
+        unsafe { self.backing().grow_zeroed(ptr, old, new) }
+    }
+    unsafe fn shrink(
+        &self,
+        ptr: NonNull<u8>,
+        old: Layout,
+        new: Layout,
+    ) -> Result<NonNull<[u8]>, AllocError> {
+        unsafe { self.backing().shrink(ptr, old, new) }
+    }
+}
+
+/// Scratch storage using the allocator selected when the vector is created.
+pub type AllocatorVec<T> = Vec<T, SharedAllocator>;
+
+/// Allocate a fallible scratch vector with exact initial capacity.
+pub fn try_vec<T>(capacity: usize) -> Result<AllocatorVec<T>, AllocError> {
+    let mut values = Vec::new_in(SharedAllocator::default());
+    values.try_reserve_exact(capacity).map_err(|_| AllocError)?;
+    Ok(values)
+}
+
+/// Fallible growth operations used by the JSON decoder.
+pub trait TryVecExt<T> {
+    /// Append after reserving enough capacity through the retained allocator.
+    fn try_push(&mut self, value: T) -> Result<(), AllocError>;
+    /// Copy a slice after reserving enough capacity through the retained allocator.
+    fn try_extend_from_slice(&mut self, values: &[T]) -> Result<(), AllocError>
+    where
+        T: Clone;
+}
+
+impl<T> TryVecExt<T> for AllocatorVec<T> {
+    fn try_push(&mut self, value: T) -> Result<(), AllocError> {
+        self.try_reserve(1).map_err(|_| AllocError)?;
+        self.push(value);
+        Ok(())
+    }
+    fn try_extend_from_slice(&mut self, values: &[T]) -> Result<(), AllocError>
+    where
+        T: Clone,
+    {
+        self.try_reserve(values.len()).map_err(|_| AllocError)?;
+        self.extend_from_slice(values);
+        Ok(())
+    }
+}
