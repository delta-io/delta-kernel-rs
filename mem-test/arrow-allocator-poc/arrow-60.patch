+// SPDX-License-Identifier: Apache-2.0
+
+//! Fallible backing storage for the JSON decoder's variable-size output.
+
+use std::alloc::AllocError;
+use std::marker::PhantomData;
+
+use arrow_array::{
+    ArrowPrimitiveType, BooleanArray, GenericStringArray, OffsetSizeTrait, PrimitiveArray,
+};
+use arrow_buffer::alloc::{AllocatorVec, TryVecExt, try_vec};
+use arrow_buffer::{BooleanBuffer, Buffer, MutableBuffer, NullBuffer, OffsetBuffer, ScalarBuffer};
+use arrow_schema::ArrowError;
+
+use super::tape::allocation_error;
+
+pub(super) struct Validity {
+    capacity: usize,
+    len: usize,
+    buffer: Option<MutableBuffer>,
+}
+
+impl Validity {
+    pub(super) fn new(capacity: usize) -> Self {
+        Self {
+            capacity,
+            len: 0,
+            buffer: None,
+        }
+    }
+
+    pub(super) fn append_non_null(&mut self) {
+        self.len += 1;
+    }
+
+    pub(super) fn append_null(&mut self) -> Result<(), ArrowError> {
+        if self.buffer.is_none() {
+            let mut buffer = MutableBuffer::try_from_len_zeroed(self.capacity.div_ceil(8))
+                .map_err(|_| allocation_error(AllocError))?;
+            buffer.as_slice_mut().fill(0xff);
+            self.buffer = Some(buffer);
+        }
+        let buffer = self
+            .buffer
+            .as_mut()
+            .ok_or_else(|| allocation_error(AllocError))?;
+        buffer.as_slice_mut()[self.len / 8] &= !(1 << (self.len % 8));
+        self.len += 1;
+        Ok(())
+    }
+
+    pub(super) fn finish(&mut self) -> Option<NullBuffer> {
+        self.buffer
+            .take()
+            .map(|buffer| NullBuffer::new(BooleanBuffer::new(buffer.into(), 0, self.len)))
+    }
+}
+
+pub(super) struct StringBuilder<O: OffsetSizeTrait> {
+    values: AllocatorVec<u8>,
+    offsets: AllocatorVec<O>,
+    validity: Validity,
+}
+
+impl<O: OffsetSizeTrait> StringBuilder<O> {
+    pub(super) fn new(rows: usize, bytes: usize) -> Result<Self, ArrowError> {
+        let mut offsets = try_vec(
+            rows.checked_add(1)
+                .ok_or_else(|| allocation_error(AllocError))?,
+        )
+        .map_err(allocation_error)?;
+        offsets
+            .try_push(O::from_usize(0).ok_or(ArrowError::OffsetOverflowError(0))?)
+            .map_err(allocation_error)?;
+        Ok(Self {
+            values: try_vec(bytes).map_err(allocation_error)?,
+            offsets,
+            validity: Validity::new(rows),
+        })
+    }
+
+    pub(super) fn append_value(&mut self, value: &str) -> Result<(), ArrowError> {
+        let len = self
+            .values
+            .len()
+            .checked_add(value.len())
+            .ok_or_else(|| allocation_error(AllocError))?;
+        let offset = O::from_usize(len).ok_or(ArrowError::OffsetOverflowError(len))?;
+        self.values
+            .try_extend_from_slice(value.as_bytes())
+            .map_err(allocation_error)?;
+        self.offsets.try_push(offset).map_err(allocation_error)?;
+        self.validity.append_non_null();
+        Ok(())
+    }
+
+    pub(super) fn append_null(&mut self) -> Result<(), ArrowError> {
+        self.validity.append_null()?;
+        self.offsets
+            .try_push(
+                O::from_usize(self.values.len())
+                    .ok_or(ArrowError::OffsetOverflowError(self.values.len()))?,
+            )
+            .map_err(allocation_error)
+    }
+
+    pub(super) fn finish(mut self) -> Result<GenericStringArray<O>, ArrowError> {
+        GenericStringArray::try_new(
+            OffsetBuffer::new(ScalarBuffer::from(self.offsets)),
+            Buffer::from(self.values),
+            self.validity.finish(),
+        )
+    }
+}
+
+pub(super) struct PrimitiveBuilder<P: ArrowPrimitiveType> {
+    values: AllocatorVec<P::Native>,
+    validity: Validity,
+    marker: PhantomData<P>,
+}
+
+impl<P: ArrowPrimitiveType> PrimitiveBuilder<P> {
+    pub(super) fn new(rows: usize) -> Result<Self, ArrowError> {
+        Ok(Self {
+            values: try_vec(rows).map_err(allocation_error)?,
+            validity: Validity::new(rows),
+            marker: PhantomData,
+        })
+    }
+    pub(super) fn append_value(&mut self, value: P::Native) -> Result<(), ArrowError> {
+        self.values.try_push(value).map_err(allocation_error)?;
+        self.validity.append_non_null();
+        Ok(())
+    }
+    pub(super) fn append_null(&mut self) -> Result<(), ArrowError> {
+        self.values
+            .try_push(P::Native::default())
+            .map_err(allocation_error)?;
+        self.validity.append_null()
+    }
+    pub(super) fn finish(mut self) -> PrimitiveArray<P> {
+        PrimitiveArray::new(ScalarBuffer::from(self.values), self.validity.finish())
+    }
+}
+
+pub(super) struct BooleanBuilder {
+    values: AllocatorVec<u8>,
+    validity: Validity,
+}
+
+impl BooleanBuilder {
+    pub(super) fn new(rows: usize) -> Result<Self, ArrowError> {
+        let mut values = try_vec(rows.div_ceil(8)).map_err(allocation_error)?;
+        values.resize(rows.div_ceil(8), 0);
+        Ok(Self {
+            values,
+            validity: Validity::new(rows),
+        })
+    }
+    pub(super) fn append_value(&mut self, value: bool) {
+        let index = self.validity.len;
+        if value {
+            self.values[index / 8] |= 1 << (index % 8);
+        }
+        self.validity.append_non_null();
+    }
+    pub(super) fn append_null(&mut self) -> Result<(), ArrowError> {
+        self.validity.append_null()
+    }
+    pub(super) fn finish(mut self) -> BooleanArray {
+        BooleanArray::new(
+            BooleanBuffer::new(self.values.into(), 0, self.validity.len),
+            self.validity.finish(),
+        )
+    }
+}
